

# THEME
config-file = ?~/.dots/ghostty/theme

# FONTS
font-family = "MonoLisa"
font-size = 13
adjust-cell-height = 45%
font-feature = +ss04
font-feature = +ss06
font-feature = +ss07
font-feature = +ss08
font-feature = +ss10
font-feature = +ss11

# CURSOR
cursor-style = bar
cursor-style-blink = false
adjust-cursor-thickness = 2
